            add r9.x, r9.x, -r8.x
            mad r8.x, r0.z, r9.x, r8.x
            add r9.x, ones, -r8.x
            mad r8.x, r0.y, r9.x, r8.x
            mul r8.x, r8.x, r8.w
            ifu light1_channel1
                mad r14.xyz, r5, r8.x, r14
            .else
                mad r4.xyz, r5, r8.x, r4
            .end
        .end
        ifu light2_active
            mov r5, lightcolor[2]
            ifu light2_channel1
                mov r0, config[1]
            .else
                mov r0, config[0]
            .end
            mov r6, lightpos[2]
            mad r6.xyz, -r1, r6.w, r6
            dp3 r3.x, r6, r6
            max r3.x, constants.z, r3.x
            rsq r3.y, r3.x
            mul r6.xyz, r6, r3.y
            dp3 r8.x, r2, r6
            mov r8.w, ones
            ifu light2_attenuate
                mov r9, lightdir[2]
                mov r10.x, ones
                cmp zeros, eq, eq, r0.w
                ifc cmp.x
                    dp3 r10.y, r2, r9
                    max r10.y, zeros, r10.y
                    mov r13, zeros
                    sge r13.x, r8.x, r13.x
                    mul r10.y, r10.y, r13.x
