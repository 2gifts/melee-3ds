        mov r9, shade[2]
        mad r8, r9, r7.w, r8
        mov r9, shade[3]
        mad r8, r9, r15, r8
        mov r9, shade[4]
        mad r8, r9, r15.w, r8
        add r8, shade[0], r8
        max r9, zeros, r8
        min r9, ones, r9
        add r9, r9, -r8
        mov r10, finalclamp
        mad r8, r10, r9, r8
        mul r8, v7, r8
