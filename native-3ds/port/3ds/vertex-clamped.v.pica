                .end
                dp3 r8.y, cosattenuation[2], r10
                max r8.y, zeros, r8.y
                cmp zeros, lt, lt, r8.z
                ifc cmp.x
                    rcp r8.w, r8.z
                    mul r8.w, r8.w, r8.y
                .else
                    mov r8.w, zeros
                .end
            .end
            max r9.x, zeros, r8.x
            add r9.x, r9.x, -r8.x
            mad r8.x, r0.z, r9.x, r8.x
            add r9.x, ones, -r8.x
            mad r8.x, r0.y, r9.x, r8.x
            mul r8.x, r8.x, r8.w
            ifu light2_channel1
                mad r14.xyz, r5, r8.x, r14
            .else
                mad r4.xyz, r5, r8.x, r4
            .end
        .end
        ifu light3_active
            mov r5, lightcolor[3]
            ifu light3_channel1
                mov r0, config[1]
            .else
                mov r0, config[0]
            .end
            mov r6, lightpos[3]
            mad r6.xyz, -r1, r6.w, r6
            dp3 r3.x, r6, r6
            max r3.x, constants.z, r3.x
            rsq r3.y, r3.x
            mul r6.xyz, r6, r3.y
            dp3 r8.x, r2, r6
            mov r8.w, ones
            ifu light3_attenuate
                mov r9, lightdir[3]
                mov r10.x, ones
                cmp zeros, eq, eq, r0.w
                ifc cmp.x
                    dp3 r10.y, r2, r9
                    max r10.y, zeros, r10.y
                    mov r13, zeros
                    sge r13.x, r8.x, r13.x
                    mul r10.y, r10.y, r13.x
                    mul r10.z, r10.y, r10.y
                    dp3 r8.z, attenuation[3], r10
                .else
                    dp3 r10.y, r6, r9
                    max r10.y, zeros, r10.y
                    mul r10.z, r10.y, r10.y
                    mov r12.x, ones
                    mul r3.z, r3.x, r3.y
                    mov r12.y, r3.z
                    mov r12.z, r3.x
                    dp3 r8.z, attenuation[3], r12
                .end
                dp3 r8.y, cosattenuation[3], r10
                max r8.y, zeros, r8.y
                cmp zeros, lt, lt, r8.z
                ifc cmp.x
                    rcp r8.w, r8.z
                    mul r8.w, r8.w, r8.y
                .else
                    mov r8.w, zeros
                .end
            .end
            max r9.x, zeros, r8.x
            add r9.x, r9.x, -r8.x
            mad r8.x, r0.z, r9.x, r8.x
            add r9.x, ones, -r8.x
            mad r8.x, r0.y, r9.x, r8.x
            mul r8.x, r8.x, r8.w
            ifu light3_channel1
                mad r14.xyz, r5, r8.x, r14
            .else
                mad r4.xyz, r5, r8.x, r4
            .end
        .end
        mov r10, zeros
        sge r9, v4, r10
        max r10, zeros, v4
        add r7, r10, -v1
        mad r7, r9, r7, v1
        mov r15, material1
        ifu channel0_lit
            max r4.xyz, zeros, r4
            min r4.xyz, ones, r4
            mul r7.xyz, r7, r4
        .end
        ifu channel1_lit
            max r14.xyz, zeros, r14
            min r14.xyz, ones, r14
            mul r15.xyz, r15, r14
        .end
