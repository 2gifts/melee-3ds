; Clamped material program: fixed v7 scale and v8 bias.
; Generated by tools/generate_vertex_shader.py; layout: gpu_vertex.h.
.fvec model[30], normal[30], projection[4], lightpos[4], lightdir[4], lightcolor[4]
.fvec attenuation[4], cosattenuation[4], shade[5], ambient[2], config[2], material1, finalclamp
.constf constants(0.0,1.0,0.000000000001,2.0)
.bool constant_color, unlit_color, light0_active, light1_active, light2_active, light3_active, light0_channel1, light1_channel1, light2_channel1, light3_channel1, light0_attenuate, light1_attenuate, light2_attenuate, light3_attenuate, channel0_lit, channel1_lit
.alias zeros constants.xxxx
.alias ones constants.yyyy
.out outpos position
.out outcolor color
.out outtex texcoord0
.proc main
    jmpu constant_color, flat_vertex
    jmpu unlit_color, unlit_vertex
full_vertex:
    mov r0, v3.wwww
    cmp zeros, le, le, r0.x
    ifc cmp.x
        mova a0.x, r0.x
        dp4 r1.x, model[a0.x], v0
        dp4 r1.y, model[a0.x+1], v0
        dp4 r1.z, model[a0.x+2], v0
        mov r1.w, ones
        dp4 outpos.x, projection[0], r1
        dp4 outpos.y, projection[1], r1
        dp4 outpos.z, projection[2], r1
        dp4 outpos.w, projection[3], r1
            dp3 r2.x, normal[a0.x], v3
            dp3 r2.y, normal[a0.x+1], v3
            dp3 r2.z, normal[a0.x+2], v3
            dp3 r3.x, r2, r2
            max r3.x, constants.z, r3.x
            rsq r3.x, r3.x
            mul r2.xyz, r2, r3.x
        mov r4, ambient[0]
        mov r14, ambient[1]
        ifu light0_active
            mov r5, lightcolor[0]
            ifu light0_channel1
                mov r0, config[1]
            .else
                mov r0, config[0]
            .end
            mov r6, lightpos[0]
            mad r6.xyz, -r1, r6.w, r6
            dp3 r3.x, r6, r6
            max r3.x, constants.z, r3.x
            rsq r3.y, r3.x
            mul r6.xyz, r6, r3.y
            dp3 r8.x, r2, r6
            mov r8.w, ones
            ifu light0_attenuate
                mov r9, lightdir[0]
                mov r10.x, ones
                cmp zeros, eq, eq, r0.w
                ifc cmp.x
                    dp3 r10.y, r2, r9
                    max r10.y, zeros, r10.y
                    mov r13, zeros
                    sge r13.x, r8.x, r13.x
                    mul r10.y, r10.y, r13.x
                    mul r10.z, r10.y, r10.y
                    dp3 r8.z, attenuation[0], r10
                .else
                    dp3 r10.y, r6, r9
                    max r10.y, zeros, r10.y
                    mul r10.z, r10.y, r10.y
                    mov r12.x, ones
                    mul r3.z, r3.x, r3.y
                    mov r12.y, r3.z
                    mov r12.z, r3.x
                    dp3 r8.z, attenuation[0], r12
                .end
                dp3 r8.y, cosattenuation[0], r10
                max r8.y, zeros, r8.y
                cmp zeros, lt, lt, r8.z
                ifc cmp.x
                    rcp r8.w, r8.z
                    mul r8.w, r8.w, r8.y
                .else
                    mov r8.w, zeros
                .end
            .end
            max r9.x, zeros, r8.x
            add r9.x, r9.x, -r8.x
            mad r8.x, r0.z, r9.x, r8.x
            add r9.x, ones, -r8.x
            mad r8.x, r0.y, r9.x, r8.x
            mul r8.x, r8.x, r8.w
            ifu light0_channel1
                mad r14.xyz, r5, r8.x, r14
