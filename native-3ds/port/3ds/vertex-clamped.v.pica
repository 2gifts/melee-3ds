            dp3 r3.x, r6, r6
            max r3.x, constants.z, r3.x
            rsq r3.y, r3.x
            mul r6.xyz, r6, r3.y
            dp3 r8.x, r2, r6
            mov r8.w, ones
            ifu light1_attenuate
                mov r9, lightdir[1]
                mov r10.x, ones
                cmp zeros, eq, eq, r0.w
                ifc cmp.x
                    dp3 r10.y, r2, r9
                    max r10.y, zeros, r10.y
                    mov r13, zeros
                    sge r13.x, r8.x, r13.x
                    mul r10.y, r10.y, r13.x
                    mul r10.z, r10.y, r10.y
                    dp3 r8.z, attenuation[1], r10
                .else
                    dp3 r10.y, r6, r9
                    max r10.y, zeros, r10.y
                    mul r10.z, r10.y, r10.y
                    mov r12.x, ones
                    mul r3.z, r3.x, r3.y
                    mov r12.y, r3.z
                    mov r12.z, r3.x
                    dp3 r8.z, attenuation[1], r12
                .end
                dp3 r8.y, cosattenuation[1], r10
                max r8.y, zeros, r8.y
                cmp zeros, lt, lt, r8.z
                ifc cmp.x
                    rcp r8.w, r8.z
                    mul r8.w, r8.w, r8.y
                .else
                    mov r8.w, zeros
                .end
            .end
