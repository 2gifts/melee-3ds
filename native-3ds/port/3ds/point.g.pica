; GX point expansion after the shared transform/lighting vertex shader.
; Inputs are native clip position, shaded color, and native texture UV.
.gsh point c0
.fvec point_params
.constf point_constants(0.0,1.0,0.0,0.0)
.out point_position position
.out point_color color
.out point_uv texcoord0
.entry point_main
.proc point_main
    mov r0, v0
    cmp point_constants.x, lt, lt, r0.w
    jmpc !cmp.x, point_done
    add r1.x, r0.z, r0.w
    cmp point_constants.x, le, le, r1.x
    jmpc !cmp.x, point_done
    cmp point_constants.x, ge, ge, r0.z
    jmpc !cmp.x, point_done
    mul r1.xy, point_params, r0.w
    mov r2, v2
    mov r3, v1
    ; Top left (native x+, y+).
    setemit 0
    mov point_position, r0
    add point_position.xy, r0, r1
    mov point_color, r3
    mov point_uv, r2
    emit
    ; Bottom left (native x-, y+).
    setemit 1
    mov point_position, r0
    add point_position.x, r0.x, -r1.x
    add point_position.y, r0.y, r1.y
    mov point_color, r3
    mov point_uv, r2
    add point_uv.y, -point_params.w, r2.y
    emit
    ; Top right (native x+, y-).
    setemit 2, prim
    mov point_position, r0
    add point_position.x, r0.x, r1.x
    add point_position.y, r0.y, -r1.y
    mov point_color, r3
    mov point_uv, r2
    add point_uv.x, point_params.z, r2.x
    emit
    ; Reuse the last two emitted vertices for the second triangle.
    setemit 0, inv prim
    mov point_position, r0
    add point_position.xy, r0, -r1
    mov point_color, r3
    mov point_uv, r2
    add point_uv.x, point_params.z, r2.x
    add point_uv.y, -point_params.w, r2.y
    emit
point_done:
    end
.end
